@model CustomerDto
@{
    Layout = null;
}


<form class="form" id="editCustomerForm">

    <input type="hidden" asp-for="Id" />
    <div class="fv-row mb-7">
        <label class="required fw-bold fs-6 mb-2">إسم العميل</label>
        <input asp-for="CustomerName" class="border-primary  form-control   mb-3 mb-lg-0" autocomplete="off" />
        <span asp-validation-for="CustomerName" class="form-text text-danger"></span>
    </div>

    <div class="fv-row mb-7">
        <label class="required fw-bold fs-6 mb-2">رقم الهاتف</label>
        <input asp-for="CustomerPhone" class="border-primary  form-control   mb-3 mb-lg-0" autocomplete="off" />
        <span asp-validation-for="CustomerPhone" class="form-text text-danger"></span>
    </div>

    <div class="fv-row mb-7">
        <label class="required fw-bold fs-6 mb-2">العنوان</label>
        <input asp-for="CustomerAddress " class="border-primary  form-control   mb-3 mb-lg-0" autocomplete="off" />
        <span asp-validation-for="CustomerAddress " class="form-text text-danger"></span>
    </div>

 

    <div class="text-center pt-15">
        <button type="reset" class="btn btn-light me-3" data-bs-dismiss="modal">الغاء</button>
        <button type="button" onclick="EditCustomer()" class="btn btn-primary" data-kt-users-modal-action="submit">
            <span class="indicator-label">تعديل</span>
        </button>
    </div>
</form>



